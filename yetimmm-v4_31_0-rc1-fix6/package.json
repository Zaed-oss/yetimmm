{
  "name": "yetimmm",
  "version": "4.31.0",
  "private": true,
  "type": "module",
  "description": "Yetimmm - MT5 Expert Advisor + Cloudflare Worker bridge + Telegram Mini App",
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:docs": "node scripts/check.mjs --write-docs",
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler dev --config worker/wrangler.toml",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry",
    "deploy:raw": "wrangler deploy --config worker/wrangler.toml",
    "setup:bot": "node scripts/setup-bot.mjs",
    "setup": "node scripts/setup.mjs",
    "diagnose": "node scripts/diagnose.mjs"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
